# =============================================================================
# Ezlain Backend - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Django Core ---
# Generate a new secret key for production: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production — True exposes detailed error pages and enables debug toolbar.
DEBUG=True

# Controls which settings module is loaded: 'development' or 'production'
DJANGO_ENV=development

# Comma-separated list of hostnames this Django instance can serve.
# In production: ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Full database URL (used by some deployment platforms like Heroku/Railway).
DATABASE_URL=postgres://user:password@localhost:5432/ezlain_db

# Individual database connection params (used in production settings).
DB_NAME=ezlain_db
DB_USER=ezlain_user
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# --- Redis ---
# Redis is used for both caching and as the Celery message broker.
REDIS_URL=redis://127.0.0.1:6379/0

# Celery broker URL — defaults to REDIS_URL if not set separately.
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# --- Email ---
# SMTP settings for sending transactional emails (order confirmations, password resets).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@ezlain.com

# --- CORS ---
# Comma-separated list of origins allowed to make cross-origin requests.
# In development, your frontend dev server (e.g., http://localhost:3000).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
