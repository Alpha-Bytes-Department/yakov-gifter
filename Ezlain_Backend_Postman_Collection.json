  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"securepassword123\",\n  \"password_confirm\": \"securepassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/accounts/register/",
              "host": ["{{base_url}}"],
              "path": ["accounts", "register", ""]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"securepassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/accounts/login/",
              "host": ["{{base_url}}"],
              "path": ["accounts", "login", ""]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"<refresh_token_here>\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/accounts/logout/",
              "host": ["{{base_url}}"],
              "path": ["accounts", "logout", ""]
            }
          }
        },
        {
          "name": "Request Password Reset",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/accounts/password-reset/",
              "host": ["{{base_url}}"],
              "path": ["accounts", "password-reset", ""]
            }
          }
        },
        {
          "name": "Confirm Password Reset",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uid\": \"<uid_b64_here>\",\n  \"token\": \"<token_here>\",\n  \"new_password\": \"newsecurepassword123\",\n  \"new_password_confirm\": \"newsecurepassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/accounts/password-reset-confirm/",
              "host": ["{{base_url}}"],
              "path": ["accounts", "password-reset-confirm", ""]
            }
          }
        }
      ]
